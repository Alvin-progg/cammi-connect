# CamiConnect environment. Copy to .env.local and fill in. See db/README.md.
# Never commit real values. Only NEXT_PUBLIC_* reaches the browser.

# Supabase (hosted project; ADR-0003)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Seed (npm run db:seed). Synthetic accounts only.
SEED_DOCTOR_EMAIL=doctor@example.test
# Optional: lets the seed create the doctor auth user if it does not exist.
SEED_DOCTOR_PASSWORD=
# Optional
SEED_DOCTOR_NAME=Dr. Maya Santos
# Optional: synthetic administrator for /admin.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Synthetic Administrator
# Optional: synthetic front desk staff for /front-desk.
SEED_FRONT_DESK_EMAIL=frontdesk@example.test
SEED_FRONT_DESK_PASSWORD=
SEED_FRONT_DESK_NAME=Synthetic Front Desk

# AI providers (ADR-0006). Server-only.
GEMINI_API_KEY=
# Optional: defaults shown.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GROQ_API_KEY=
# A Groq chat model that supports response_format json_object.
GROQ_MODEL=
# Optional: defaults shown.
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Notification emails (0046/0047). Uncomment all to turn email on; leave all
# commented to keep it off. Setting some but not all is an error. Server-only.
# Gmail SMTP: the account needs 2-Step Verification and a 16-character App
# Password (Google Account > Security > App passwords). Never the real password.
# SMTP_HOST=smtp.gmail.com
# 465 uses implicit TLS; 587 uses STARTTLS. Both work with Gmail.
# SMTP_PORT=465
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-app-password
# Gmail rewrites the From address unless it is this account or a verified alias.
# MAIL_FROM="CamiConnect <your-account@gmail.com>"
# Origin for links in emails.
# APP_BASE_URL=http://localhost:3000
